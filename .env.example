# --- Database ---
# Local dev uses SQLite. Point this at Postgres (e.g. a Supabase connection
# string) in production — the schema is Postgres-compatible.
DATABASE_URL="file:./dev.db"

# --- Lead discovery (optional) ---
# Without this, lead discovery uses a small curated sample of realistic
# "no website" businesses so the full pipeline is demoable without a key.
APOLLO_API_KEY=

# --- AI (optional) ---
# Without this, business analysis, lead scoring, and outreach copy fall back
# to deterministic templates instead of Claude.
ANTHROPIC_API_KEY=

# --- Email sending (optional) ---
# Without this, approved outreach messages are marked SENT but not actually
# delivered (simulated send) — useful for demoing the approval flow safely.
RESEND_API_KEY=
RESEND_FROM_EMAIL="AVEXA <outreach@avexa.ai>"
