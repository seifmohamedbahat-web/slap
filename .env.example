# Secret used to sign admin session tokens. Set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Credentials for the first admin user (used once, when the database is created).
# After first run, manage the password from the database or keep these safe.
ADMIN_EMAIL=admin@digitalorbit.agency
ADMIN_PASSWORD=orbit2026

# Real email delivery for inquiry/booking notifications (optional).
# Without a key, notifications are logged to the server console instead.
# Get a free key at https://resend.com, then set a sender on your domain.
# The DESTINATION address is the "Notification email" in admin Settings.
RESEND_API_KEY=
EMAIL_FROM=DigitalOrbit <onboarding@resend.dev>
