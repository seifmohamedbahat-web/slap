# Copy this file to jarvis/backend/.env and fill in your keys.
# NEVER commit the real .env — it is git-ignored.

# --- Required (Phase 1) ---------------------------------------------------
# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# --- Optional -------------------------------------------------------------
# Model used for reasoning/tool-use.
JARVIS_MODEL=claude-opus-4-8
# Max output tokens per response (streamed).
JARVIS_MAX_TOKENS=64000
# Backend bind address.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Comma-separated directories Jarvis may READ (Phase 1 is read-only).
# Empty = your user home directory only. Example (Windows):
# JARVIS_ALLOWED_ROOTS=C:\Users\you,D:\Projects
JARVIS_ALLOWED_ROOTS=
# SQLite location. Empty = ~/.jarvis/jarvis.db
JARVIS_DB_PATH=

# --- Voice (Phase 2) --------------------------------------------------------
# Requires the voice extras: pip install -r requirements-voice.txt
# Auto-start wake-word listening once models load.
JARVIS_VOICE_ENABLED=true
# openWakeWord pretrained model ("hey jarvis").
JARVIS_WAKE_WORD=hey_jarvis_v0.1
JARVIS_WAKE_THRESHOLD=0.5
# faster-whisper size: tiny | base | small | medium
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_LANGUAGE=en
# TTS: auto (ElevenLabs -> edge-tts -> pyttsx3) | elevenlabs | edge | pyttsx3 | off
JARVIS_TTS_ENGINE=auto
JARVIS_TTS_MAX_CHARS=1200
JARVIS_EDGE_VOICE=en-US-GuyNeural
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5
# Also speak replies to typed messages (voice replies are always spoken).
JARVIS_SPEAK_TYPED_REPLIES=false
# Global push-to-talk hotkey.
JARVIS_PTT_HOTKEY=ctrl+shift+j

# ElevenLabs credentials (natural voice; first choice when set).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
